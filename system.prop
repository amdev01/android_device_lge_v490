# Radio
persist.data.netmgrd.qos.enable=false
persist.radio.add_power_save=1
persist.radio.apm_sim_not_pwdn=1
rild.libpath=/vendor/lib/libril-qc-qmi-1.so
ro.telephony.default_network=9
ro.use_data_netmgrd=true
telephony.lteOnCdmaDevice=0
ril.subscription.types=NV,RUIM
ro.build.target_operator=GLOBAL
ro.build.target_country=COM
persist.radio.msgtunnel.start=false
keyguard.no_require_sim=true
# CS voice first: do NOT force IMS. Without a real ImsService, calls.on.ims /
# volte_avail_ovr leave MO stuck in DIALING (UL works, no DL / no ACTIVE UI)
# and MT pages CSFB with no IncomingCall UI. VoLTE needs a later ImsService.
persist.radio.calls.on.ims=false
# Start QTI IMS daemons (init.v4xx-ims.rc); keep volte overlay false until bind.
persist.radio.ims_daemon=1
